# Environment variables template
# Copy this file to .env.local and fill in values for local development
#
# Public variables (EXPO_PUBLIC_) are exposed to client code
# Secret variables should be set in Expo Dashboard for production

# ===== Public Variables (safe to expose) =====
EXPO_PUBLIC_APP_NAME=ECVP 2026 Schedule Organizer
EXPO_PUBLIC_CONFERENCE_YEAR=2026
EXPO_PUBLIC_CONFERENCE_DATES=August 23–27, 2026
EXPO_PUBLIC_CONFERENCE_LOCATION=Bournemouth, UK
EXPO_PUBLIC_TOTAL_PRESENTATIONS=618
EXPO_PUBLIC_GITHUB_REPO=https://github.com/markwgreenlee/ecvp-2026-scheduler
EXPO_PUBLIC_CONFERENCE_WEBSITE=https://ecvp2026.uk/

# ===== Secret Variables (keep private) =====
# For production builds, set these in Expo Dashboard, not in .env files
# Examples:
# API_KEY=your-secret-key
# DATABASE_URL=your-database-url
